{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Electronics Agent Kit",
  "version": "0.1.0",
  "identifier": "org.electronics-agent-kit.eak",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Electronics Agent Kit",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "publisher": "NijoP",
    "category": "Development",
    "shortDescription": "Electronics Agent Kit - AI-powered electronics design assistant",
    "longDescription": "A desktop application for AI-assisted electronics design, component search, and datasheet analysis.",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "macOS": {
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [],
      "minimumSystemVersion": "10.15",
      "signingIdentity": null,
      "providerShortName": null
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "fs": {
      "all": true,
      "scope": [
        "$APPDATA/*",
        "$HOME/*"
      ]
    },
    "dialog": {
      "all": true,
      "open": true,
      "save": true
    }
  }
}