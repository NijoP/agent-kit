{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Electronics Agent Kit",
  "version": "0.1.0",
  "identifier": "org.electronics-agent-kit.eak",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Electronics Agent Kit",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "EAK Contributors",
    "copyright": "MIT OR Apache-2.0",
    "category": "Development",
    "shortDescription": "AI-native electronics engineering runtime",
    "longDescription": "Electronics Agent Kit (EAK) — An open-source, AI-native electronics engineering system. Intent in. Engineering model out. Verified engineering artifacts out."
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "fs": {
      "scope": {
        "allowed": [
          "$APPDATA/*",
          "$HOME/*",
          "$TEMP/*"
        ]
      }
    },
    "dialog": {
      "open": true,
      "save": true
    }
  }
}